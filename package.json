{
  "name": "react-nt-tooltip",
  "private": false,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode=demo",
    "build": "npm run build:code",
    "build:code": "tsc -b && vite build --mode=lib",
    "build:demo": "tsc -b && vite build --mode=demo",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs": "rm -rf docs && cp -rf demo/dist docs"
  },
  "main": "./dist/nt-tooltip.es.js",
  "module": "./dist/nt-tooltip.es.js",
  "exports": {
    ".": {
      "import": "./dist/nt-tooltip.es.js",
      "default": "./dist/nt-tooltip.es.js"
    },
    "./nt-tooltip.css": "./dist/nt-tooltip.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "bugs": {
    "url": "https://github.com/noistommy/react-nt-tooltip/issues"
  },
  "homepage": "https://github.com/noistommy/react-nt-tooltip#readme",
  "keywords": [
    "react",
    "tooltip"
  ],
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "react-shiki": "^0.11.1",
    "sass": "^1.103.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noistommy/react-nt-tooltip.git"
  },
  "license": "MIT"
}

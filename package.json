{
  "name": "@noistommy/nt-tooltip",
  "description": "Framework-independent tooltip configured with a single HTML attribute (nt-tooltip). Supports hover, focus and click triggers, auto-flipping placement, HTML content, and ships with TypeScript types.",
  "private": false,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite --mode=demo",
    "build": "npm run build:code",
    "build:code": "tsc -b && vite build --mode=lib",
    "build:demo": "tsc -b && vite build --mode=demo",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs": "rm -rf docs && cp -rf demo/dist docs"
  },
  "main": "./dist/nt-tooltip.cjs",
  "module": "./dist/nt-tooltip.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/nt-tooltip.umd.js",
  "jsDelivr": "./dist/nt-tooltip.umd.js",
  "exports": {
    ".": {
      "import": "./dist/nt-tooltip.es.js",
      "require": "./dist/nt-tooltip.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/nt-tooltip.umd.js"
    },
    "./nt-tooltip.css": "./dist/nt-tooltip.css"
  },
  "files": [
    "dist",
    "src",
    "llms.txt"
  ],
  "bugs": {
    "url": "https://github.com/noistommy/nt-tooltip/issues"
  },
  "homepage": "https://noistommy.github.io/nt-tooltip/",
  "keywords": [
    "typescript",
    "javascript",
    "tooltip",
    "vanilla-js",
    "html-attribute",
    "framework-agnotic",
    "popover",
    "hint"
  ],
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "react-shiki": "^0.11.1",
    "sass": "^1.103.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noistommy/nt-tooltip.git"
  },
  "license": "MIT",
  "dependencies": {
    "@noistommy/souple": "^1.0.1"
  }
}
